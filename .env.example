# isaac-mcp environment template — copy to .env and fill in (never commit .env)
# Isaac Sim install root (auto-detected from common locations when unset)
ISAAC_SIM_PATH=C:/Program Files/NVIDIA/Isaac Sim
# Optional: explicit Isaac Sim Python (Python 3.11 for Isaac Sim 5.x).
# Defaults to .venv-isaac311/Scripts/python.exe, then the bundle python.bat.
ISAAC_PYTHON=
# Optional: override depot / job directories (defaults: ./scenes/ ./jobs/)
ISAAC_MCP_SCENES_DIR=./scenes/
ISAAC_MCP_JOBS_DIR=./jobs/
# Backend bind (fleet registry: backend 11049, frontend 11048)
ISAAC_MCP_HOST=127.0.0.1
ISAAC_MCP_PORT=11049
